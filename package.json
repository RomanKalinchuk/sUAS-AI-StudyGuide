{
  "name": "ai-studyguide",
  "version": "1.0.0",
  "description": "sUAS Edge AI & Autonomous Systems Engineering Masterclass",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/css/main.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./public/css/main.css --watch",
    "start": "node server.js",
    "dev": "concurrently \"npm run watch:css\" \"node server.js\""
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1"
  }
}
